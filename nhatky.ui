    background-color: white;
    height: 35px;
    text-align: center;
    font-family: &quot;Avenir Next&quot;, Arial, sans-serif;
    font-size: 16px;
    font-weight: bold;
    color: #333333;
}
QSlider::groove:horizontal {
    height: 4px;
}

#progressBar_emotion::chunk {
    background-color: #7FBF9F;
    border-radius: 18px;
    margin: 2px;
}
#progressBar_emotion {
    border: 2px solid #E0E0E0;
    border-radius: 20px;
    background-color: white;
    height: 35px;
    text-align: center;
    font-family: &quot;Avenir Next&quot;, Arial, sans-serif;
