}
QSlider::groove:horizontal {
    border: 1px solid #ccc;
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #63B995;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #63B995;
    border: 2px solid white;
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
